 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Strong opinions on politics. Attitude problem. Needs his teeth knocked in. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "|~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "@HailyJoelOsmand~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Blocked & Reported @Mods ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "|~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "@AlleyValkyrie~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Hey, you can\u2019t be threatening ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "our ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "members. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "|~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "@HarveySilverstein ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "Header_and_Footer", "text": "Sorry, my bad. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "tex