extSpan", "font": "P3552", "text": "answer.\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "Header_and_Footer", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Wait~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "... how does that work?\u201d Vashra said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Allow me to explain AI.\u201d Alex said, pulling over a whiteboard. \u201dThis has already been covered by xkcd, so I\u2019ll just repeat their solution, while adding a little bit of flair..\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "Header_and_Footer", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "So, first, you take the big bucket of numbers.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Alex ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "drew ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.