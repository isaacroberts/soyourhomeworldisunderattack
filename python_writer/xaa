c_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Luckily, every part of the country had a traffic intersection. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "That made it easy to ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P631", "text": "Hooonnkk~", "tabs": 0, "_align": "right"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "hear God\u2019s chorus over the rushing of machinery. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I resolved to write a religion. I figured that would fix it. Seems like maybe it\u2019s a necessary component. Why not give it a whack. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Revelations~", "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Where: Charleston, SC~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P3197", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["Charleston, SC~"], "dparams": {}, "obj": "Where", "hasColon": true}, "obj": "Where~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3197", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "My first vision ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "of Science ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "came to me while standing at a traffic intersection. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "Boy, these cars are hot.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "That alarmed me greatly. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Obviously, if the vehicles themselves are hot, that means they\u2019re creating heat. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Presumably, projecting it into the atmosphere.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " It\u2019s not hard to imagine how that heat might affect the climate. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "Community = Good~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I was headed to Panera Bread. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Panera Bread was always crowded with people having meetups, playing games, having activities. Chess tournaments, special ed meetups, office groups, cults, sorry - prayer groups, teachers, unions, and more. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I knew for a fact th~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "is~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " was sustainable. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "People meeting to share food in comfortable, lounging environment is always sustainable, and if it\u2019s not, I don\u2019t want it. Make it sustainable. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "A~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": " car nearly ran me over. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I smiled, flipping the driver the bird. According to Science, there would be no retribution for the bastard lest I act myself. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I threw rocks at his car. It didn\u2019t hit, but I at least created the ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "probability cloud~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " of ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "consequences~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": ". ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Then, I nearly got hit 5 or 6 times. Once a pattern was formed, I learned not to blame the Drivers. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "I ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "blame~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1180", "text": "the system. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "What could that mean?~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Quadrie stood rapturously under a cell tower (not 5G).~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Cell towers were a kind of system. And by God, I was going to rewrite a scientific approach to not getting run over by cars. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3548", "text": "Busses~", "tabs": 0, "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "by Quadrie Liebnitz, PhD~", "tabs": 0, "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "It went super-viral online. That\u2019s when people look up from your book and tell strangers ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "in the supermarket ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "about it. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I sold 100,000 copies, with guest appearances on mid-evening TV.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "I ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "became the world\u2019s 3~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1828", "text": "rd~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1828", "text": " youngest black millionaire. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "But I wasn\u2019t done yet. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Fridge~", "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Where: Rocks/Silverstein/Green/Betterweather/Stimpson Residence, Charleston SC~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P3198", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["Rocks/Silverstein/Green/Betterweather/Stimpson Residence, Charleston SC~"], "dparams": {}, "obj": "Where", "hasColon": true}, "obj": "Where~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3198", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Hey, Jake, where\u2019s that box I had in the fridge?\u201d Harvey asked. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Oh. I ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "threw~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " it ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "out~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ".\u201d Jake said. \u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "It was old.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "C\u2019mon, man.\u201d Harvey said. \u201cThis is equivalent to the burning of the Library of Alexandria.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Man, don\u2019t give me that.\u201d Jake said. \u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "It was off!\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "It was a life form!\u201d Harvey protested. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Right, that\u2019s what I said!\u201d Jake said. \u201cSo, I poured it out!\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Oh, so you\u2019re the authoritarians of the Fridge Reich?\u201d Harvey demanded. \u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Determining~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " who lives, and who dies?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Sure.\u201d Jake said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Monster~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ".\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Harvey ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "said. \u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "That was a~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "n~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " alien. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Gifted to me by the Conspiracy Theory Central facebook group / bar.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Oh.\u201d Jake said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Yeah.\u201d Harvey said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I was securing Lebensraum.\u201d Jake said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Human Nationalist!\u201d Harvey accused. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Don\u2019t give me that.\u201d Jake said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "You only care about your own species.\u201d Harvey accused. \u201cNothing for the aliens of the galaxy. Only mono-culture everywhere, forever.\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cIt\u2019s not like that.\u201d Jake said. \u201cI just think it looks better Green.\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "But you ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "are~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " a Human Nationalist.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Harvey accused. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Yes.\u201d Jake said. \u201cYes, I am a Human Nationalist, and I don\u2019t think it\u2019s a big deal.\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "It is a big deal.\u201d Harvey said. \u201cThink of the galaxy, empty except song, forever.\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "C\u2019mon.\u201d Jake said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Harvey shook his head. \u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "You ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "say Human now, but once you have no more ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "xenos~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " to kill, you\u2019ll turn on~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Humans.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Jake rolled his eyes. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Science ~", "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Where: Charleson Science Museum~", "codeMarker": {"py/id": 7137}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["Charleson Science Museum~"], "dparams": {}, "obj": "Where", "hasColon": true}, "obj": "Where~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3196", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "It didn\u2019t take me long to~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "find~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " ~", "tabs": 0, "_align": "left"}, {"py/objec