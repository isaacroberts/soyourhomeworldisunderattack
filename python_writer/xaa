ams": {"py/object": "objects.code_objects.CodeParams", "lparams": ["CommunistsWin~"], "dparams": {}, "obj": "Label", "hasColon": true}, "obj": "Label~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "They killed the author. He was a left-wing academic, and a revolutionary writer. You can\u2019t have those if you plan on oppressing people. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "They did fix climate change. Why wouldn\u2019t they? ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Nobody had to eat bugs, but it wasn\u2019t as nice as it should\u2019ve been. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "We did have to fight a civil war. It wasn\u2019t long, but it was a civil war. It\u2019s because of their escalation tactics. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "They got the ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "escalation tactics the ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "same place we all got it. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "T~", "tabs": 0, "_align": "left"}, {"py/object"