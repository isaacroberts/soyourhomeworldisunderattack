, "text": "\u201cOkay.\u201d Vashra said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cSince you can track how you shaked it, you can unshake it.\u201d Alex said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cLike a Shake-n-Bake.\u201d Rachel said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cUh - I don\u2019t know what a Shake-n-Bake\u2019s like.\u201d Alex said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cMm.\u201d Rachel said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cYou\u2019re saying you like, rewind time on the bucket.\u201d Vashra said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cYeah.\u201d Alex said. \u201cSo you just do that a bunch. Shake it and unshake it, until it starts to look right.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.End