 "objects.text_obj.TextSpan", "font": "P3404", "text": "I\u2019m holding on to what I think is safe. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "It seems I\u2019ve found the road to nowhere ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "Somewhere in his grace. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3404", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "I yelled back when I heard ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "t~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "hunder ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "And now I\u2019m down to one last breath. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "And with it, let me say~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "Let me say:~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3404", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "\u201cHold me now!~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3404", "text": "I\u2019m six feet from the edge and I\u2019m thinking... ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.End