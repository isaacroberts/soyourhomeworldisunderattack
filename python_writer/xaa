": "P3552", "text": "and really counted on choosing the President.\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "Header_and_Footer", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Oh!\u201d the young woman said. \u201cWell, I believe in Democracy, so...\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "Header_and_Footer", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Me too, obviously.\u201d Harvey said. \u201cI guess... well, I\u2019m not taking responsibility for my end of the bargain.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The dancer pushed a ballot into his hand. \u201cHere! We\u2019re voting at 3 PM.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.code_objects.CodeTag", "text": "Ballot: On=0~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P2038", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": [], "dparams": {"on": "0"}, "obj": "Ballot", "hasColon": true}, "obj": "Ballot~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Hardline Communists~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Charleston Food Not Bombs Chapter~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Human Jack ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Ballot~", "codeMarker": {"py/id": 29917}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": [], "dparams": {}, "obj": "Ballot", "hasColon": false}, "obj": "Ballot~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Harvey stared at the ballot. \u201cPhew! Glad they only put one good one on here.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cI\u2019m putting down FNB.\u201d Rachel said. \u201cThey spend time reaching out to their community and helping people. That\u2019s exactly what I want my government to do for me.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cI\u2019m putting them down to defend my Peace Agreement with the NRA.\u201d Harvey said. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Communists Speech ~", "_align": "center"}, {"py/object": "objects.text_obj.Header", "font": "T304_P2109", "text": "(Boo!)~", "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "FNB Speech ~", "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "Heading_2", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "A wizard came up to the podium. \u201cFolks, I am the author of this book, Isaac Roberts.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cA lot of people have repeated the adage, those who seek power are the least qualified to hold it.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I believe that, very firmly. It\u2019s not just a self-selection. It\u2019s a selection for evil by a system that requires you to shut your eyes. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Those who are the least interested in shutting their eyes, know they have no place near government. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "That\u2019s why I know there are good people in this country, and they\u2019re being held down.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "This presents a logistical problem. How do we find people that don\u2019t want power, and give it to them?~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "One could spend years, seeking the country, for unwitting leaders and testing them for skills. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Or, as I did, you could find a functioning group of non-jewish people, consider it a proof of concept, and run to write a book. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I knew I had the power to write a book. I always wanted to write a book some day. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "These people exhibit telepathic empathy. I knew it was possible, I\u2019ve seen it many times, but I was excited to see it on people who were politically engaged.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "It\u2019s a group of people. I wouldn\u2019t dare remove them from their group. If one starts bossing around the others, or you can\u2019t get a clear ruling, consider the group broken, and get a new one.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I give you, the Anarchists of the Food Not Bombs organization! Famous for feeding the homeless across all 50 states, the Food Not Bombs organization is a grassroots movement that distributes both literature and food. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "They\u2019re not fighters. They\u2019re not tied with the SRA. They\u2019re not politicians. If they ran for office, they would have to go to a different room. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I give you, some empathetic, self-aware, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "non-denialist~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "non-Jewish American citizens~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "!\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "There was a golf clap. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Christian, of Food Not Bombs, lumbered up to the stage.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "Thanks. You didn\u2019t tell me you were writing this book.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "Folks, these \u2018men\u2019 here today are not men. They\u2019re gonna claim some image of manliness that isn\u2019t real. It\u2019s pomp and circumstance to cover up the truth. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "They\u2019re women. They call the cops when their feelings are hurt. They play tricksy with language. They speak to broad emotional concepts instead of the truth. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "This fake manliness tears our society apart. And it\u2019s not something that I will partipate in.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "A young crowd member raised his hand. \u201cCan you show us ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "an example of~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " real manliness?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "Sure~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": ".\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "Christian ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "said~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": ". ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "We at the Food Not Bombs organization often get asked where we get ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "the ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "food~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": " we give away~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": ". ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "Do we get corporate donations? Do we fund it out of pocket? No.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3532", "text": "\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3532", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Christian inhaled. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cOnce, as I was running through ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "S~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "avannah, Georgia~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ", I spotted a buffalo, separated from its herd. I pursued the beast, gaining on it over a 5 minute window. I jumped onto it\u2019s back, grabbing fur for dear life. The beast started bucking. They oughtta call them ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "buckalo~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": ".\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Pulling myself forward, I threw my arm around the beast\u2019s neck, locking it into a chokehold. It bucked harder, and I knew I wouldn\u2019t be on for long. I threw my body weight over, pulling the buffalo off balance. It toppled, and skidded across the slick grass. I skidded under it, and was severely bruised, but unharmed.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Thinking quickly, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I pulled out my obsidian knife and shoved it into the beast\u2019s ribcage. It gave a cry of surrender, and I knew it would not get back up. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "My compatriots rushed forward ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "to~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " skin the buffalo. Sophie started the fire, Tristen cleaned ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "the carcass~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ", and Eric ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "prepared his clutch of herbs. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Once we ate our fill, we realized we had far too much. We loaded the carcass onto a skiff, and hauled it to Charleston South Carolina, where we gave it out~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "for free.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The crowd applauded, impressed. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Rachel leaned over. \u201cHe ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "looks~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " like he could chokeslam a buffalo.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "The mountain that rides~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": ".\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " Harvey ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "whispered ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "back~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": ". ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Christian surveyed the crowd, nodded, and left the podium. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Human Jack approached the microphone to give his speech. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201cFolks, I\u2019m gonna own the lefties harder than anyone in history. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "These environmentalists, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "the~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "commies~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": ", ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "the~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " tranny-lovers, they\u2019re going to be crying their eyes out. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Bawling! Nobody\u2019s ever sobbed harder than these guys are gonna sob.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "And don\u2019t you worry about your SUVs. Who gives a shit? Not ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "me.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P1310", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "Header_and_Footer", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Boo!\u201d Harvey called. \u201cFascist!\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "Header_and_Footer", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Human Jack pointed at Harvey. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201cFolks, let\u2019s get that lefty out of here! Who\u2019s with me?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Ballot~", "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Label: Ballot1~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P2251", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["Ballot1~"], "dparams": {}, "obj": "Label", "hasColon": true}, "obj": "Label~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Harvey looked at the camera. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cFolks, if you ever get a ballot that looks like this, you should be very suspicious.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "This is clear rigging. There\u2019s the author\u2019s friends, then there\u2019s two idiots. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I would ask who made this ballot. I would ask why other people couldn\u2019t get on. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "I would check if there\u2019s some positive requirement such as money that only the ballot-rigger was able to fulfill. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "In this instance, I don\u2019t want to be antisemitic, so I\u2019m not going to dig any further.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.code_objects.CodeTag", "text": "Ballot: On=1 | Extra=0 | Links=CommunistsWin,AnarchistsWin,HumanJack~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P2039", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": [], "dparams": {"on": "1", "extra": "0", "links": "CommunistsWin,AnarchistsWin,HumanJack"}, "obj": "Ballot", "hasColon": true}, "obj": "Ballot~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Communist ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Association~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Anarchist ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Food Not Bombs ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Human Jack ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Ballot~", "codeMarker": {"py/id": 30180}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": [], "dparams": {}, "obj": "Ballot", "hasColon": false}, "obj": "Ballot~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Folks! Let\u2019s count these ballots!\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.code_objects.CodeTag", "text": "Next: Null ~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P2224", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["Null~"], "dparams": {}, "obj": "Next", "hasColon": true}, "obj": "Next~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Extended ~", "_align": "left"}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Ballot~", "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Label: ReElection~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P2252", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["ReElection~"], "dparams": {}, "obj": "Label", "hasColon": true}, "obj": "Label~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Ah.\u201d Harvey said. \u201cYes, this is the kind of ballot that it should look like. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "This is what Democracy looks like. We have an array of healthy options to choose from. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Perhaps, to ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.code_objects.CodeTag", "text": "Ballot: On=1 | Extra=1 | Links=CommunistsWin,AnarchistsWin,HumanJack,AIWinsElection,PotHol~", "codeMarker": {"py/object": "objects.code_objects.CodeMarker", "tag": "P2040", "parent": "code_5f_marker", "fontCol": null, "bgCol": null, "isSub": false, "isSheeted": false}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": [], "dparams": {"on": "1", "extra": "1", "links": "CommunistsWin,AnarchistsWin,HumanJack,AIWinsElection,PotHol"}, "obj": "Ballot", "hasColon": true}, "obj": "Ballot~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Communist ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Association~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Anarchist ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Food Not Bombs ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Human Jack ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "[ ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "   ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "] Bugs Bunny~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/objec