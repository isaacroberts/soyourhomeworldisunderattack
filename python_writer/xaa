, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cWouldn\u2019t hate to do that at all.\u201d the Great Wizard sneered. He reached into his coat pocket, and pulled out a Red deck. \u201cHere... take my own... ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "you bum...~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Thanks!\u201d Nick said. \u201cIs it a Burn deck?\u201d ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Elvis\u2019s Hairdo, no.\u201d the Great Wizard dismissed. \u201cIt\u2019s ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "a ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Creature Rush.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Game~", "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Where: White House MtG Tables~", "codeMarker": {"py/id": 18124}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["White House MtG Tables~"], "dparams": {}, "obj": "Where", "hasColon": true}, "obj": "Where~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "When: 2 AM ~", "codeMarker": {"py/id": 18124}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["2 AM~"], "dparams": {}, "obj": "When", "hasColon": true}, "obj": "When~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3187", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Nick ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "lost~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " so badly that he vow~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "ed~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " to never speak of it ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "again~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ". ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.Header", "font": "Heading_2", "text": "Author Hearing~", "_align": "center"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "Where: White House Torture Dungeon~", "codeMarker": {"py/id": 18124}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["White House Torture Dungeon~"], "dparams": {}, "obj": "Where", "hasColon": true}, "obj": "Where~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.code_objects.CodeTag", "text": "When: 4 AM~", "codeMarker": {"py/id": 18124}, "isEndTag": false, "params": {"py/object": "objects.code_objects.CodeParams", "lparams": ["4 AM~"], "dparams": {}, "obj": "When", "hasColon": true}, "obj": "When~"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3187", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Nick wandered along the hallways. In an open door, he ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "spied a sort of tribunal. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Several people were holding blow-up aliens. The leaders were wearing black trenchcoats and Matrix sunglasses, despite the darkness of the room. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "Where We Go One Go We All.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Nick glanced over his shoulder, and popped in. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "A buffalo-wearing Shaman was holding a man\u2019s head in a tupperware container of water. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "He lifted ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "the ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "man~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " up. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201cWhy is this novel different from all other political action novels?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The author blinked water out of his eyes. \u201cLucked into it, honestly.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The Shaman picked him up to look square in the eyes. \u201cWhat do you mean?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Joseph Silverstein shrugged. \u201cI mean, if you call it ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "lucky~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " to be a political fiction novelist in such unstable times.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The Shaman squinted suspiciously. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Joseph Silverstein met his eyes. \u201cE~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "ven my ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "grandma~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": " said we ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "needed one!~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P1310", "text": "\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The Shaman nodded. He set Joseph into the tupperware container. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cI have a question.\u201d a thin collar-wearing woman said, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "standing up~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ". \u201cWould you say your Jewishness made it easier to write the novel?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cUm.\u201d Joseph Silverstein said, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "looking up from the tupperware container~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ". \u201cYes, obviously, for two reasons. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "One, it cleared up a major avenue ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "of research.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "K~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "nowing that the Jews weren\u2019t responsible for anything, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "allowed me to skip a lot of science ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "denial~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ", a lot of~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": " woke college professors, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "paid protestor ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "theories~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ", etcetera.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Second, it allowed me to comfortably use the Abrahamic religion. I knew I was allowed ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "to, had the highest license possible~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ", and I knew I was doing the right thing. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "And that helped.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "So ye~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "ah~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ", I feel that nobody ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "else ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "would have been able to beat me to the punch, if they were not Jewish or some other special category, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "like Palestinian~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": ". ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Thank you.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "T~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "hat answers my question.\u201d the woman said, sitting down. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.misc_text_obj.MiscToken", "type": "soft-page-break"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "The Shaman ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "gave Joseph a nonplussed look. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "A woman in a country button stood up. \u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Do you feel like you were stepping around topics that would be uncomfortable for the Jews?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Hoo boy.\u201d Joseph Silverstein said. \u201cNo, I don\u2019t feel I was stepping around topics that would be uncomfortable for the Jews.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Hmm.\u201d the woman said, sitting back down.~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cLeticia Jones. Would you say you minimized Rachel Green\u2019s blackness?\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201cOh, I certainly hope not,\u201d Joseph said. \u201cI felt I had to acknowledge Black history in order to do the Moses story... I don\u2019t know if we really got into her Blackness enough, maybe out of some trepidation, but I\u2019d be really excited to see Rachel continue the story.\u201d~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "\u201c~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Thank you. Big fan.\u201d Leticia said, ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "sitting down. ~", "tabs": 0, "_align": "left"}, {"py/object": "objects.misc_text_obj.EndOfPara"}, {"py/object": "objects.text_obj.NewLine", "font": "P3552", "amt": 1}, {"py/object": "objects.text_obj.TextSpan", "font": "P3552", "text": "Nick sighed. ~", "tabs": 0, "_align": "left"}, {"py/object": "ob